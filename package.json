{
  "name": "unifymemfile",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for persisting and sharing project context across IDEs",
  "main": "dist/index.js",
  "bin": {
    "unifymemfile": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
